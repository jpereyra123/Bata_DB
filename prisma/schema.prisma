generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum EstadoAlumno {
  PENDIENTE
  ACTIVO
  INACTIVO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  @@map("users")
}

model Alumno {
  id              String       @id @default(uuid())
  nombre          String
  apellido        String       @default("")
  email           String       @unique
  dni             String       @default("")
  telefono        String       @default("")
  fechaNacimiento String       @default("")
  curso           String
  estado          EstadoAlumno @default(PENDIENTE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("alumnos")
}
